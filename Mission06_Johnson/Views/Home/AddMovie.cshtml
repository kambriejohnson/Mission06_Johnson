@model Mission06_Johnson.Models.Movie
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Add Movie";
}

<div class="container mt-5">
    <h2 class="mb-4">
        @(Model.MovieId == 0 ? "Add a Movie" : "Edit Movie")
    </h2>

    <form asp-action="@(Model.MovieId == 0 ? "AddMovie" : "EditMovie")" method="post">

        <!-- Hidden ID so Edit works properly -->
        <input type="hidden" asp-for="MovieId" />

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">Category</label>
            <select asp-for="CategoryId" class="form-select"
                    asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))">
                <option value="">Select a Category</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Year" class="form-label"></label>
            <input asp-for="Year" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Director" class="form-label"></label>
            <input asp-for="Director" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Rating" class="form-label"></label>
            <select asp-for="Rating" class="form-select">
                <option value="">Select Rating</option>
                <option value="G">G</option>
                <option value="PG">PG</option>
                <option value="PG-13">PG-13</option>
                <option value="R">R</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Edited" class="form-label"></label>
            <select asp-for="Edited" class="form-select">
                <option value="">Select One</option>
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="CopiedToPlex" class="form-label"></label>
            <select asp-for="CopiedToPlex" class="form-select">
                <option value="">Select One</option>
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="LentTo" class="form-label"></label>
            <input asp-for="LentTo" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <input asp-for="Notes" class="form-control" maxlength="25" />
        </div>

        <button type="submit" class="btn btn-primary">
            @(Model.MovieId == 0 ? "Add Movie" : "Update Movie")
        </button>

        <a asp-action="MovieList" class="btn btn-secondary ms-2">
            Cancel
        </a>
    </form>
</div>
