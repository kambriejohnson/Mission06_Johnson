@model Mission06_Johnson.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<div class="container mt-5">
    <h2 class="text-danger mb-4">Are you sure you want to delete this movie?</h2>

    <div class="card p-4 shadow-sm">
        <p><strong>Title:</strong> @Model.Title</p>
        <p><strong>Year:</strong> @Model.Year</p>
        <p><strong>Director:</strong> @Model.Director</p>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="MovieId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="MovieList" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>